<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sorting every installed app into groups needs the full app list (sideloaded, personal use). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Generated wallpapers. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- SceneView (the 3D pen) declares these for network models and haptics. PadStudio loads its pen from
         the APK, stays offline, and draws a 2D pen where OpenGL ES 3 is missing. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.VIBRATE"
        tools:node="remove" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false"
        tools:replace="android:required" />

    <queries>
        <package android:name="io.github.sds100.keymapper" />
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
    </queries>

    <application
        android:name=".PadStudioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PadStudio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Folder-style panel and the app library. Exported so Key Mapper's pen actions can open them. -->
        <activity
            android:name=".home.FolderPanelActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.charan.padstudio.panel"
            android:theme="@style/Theme.PadStudio.Panel" />
        <activity
            android:name=".home.LibraryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.charan.padstudio.panel"
            android:theme="@style/Theme.PadStudio.Panel" />
        <activity
            android:name=".home.EditGroupWidgetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity="com.charan.padstudio.edit"
            android:theme="@style/Theme.PadStudio.Panel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Live pressure, tilt and hover readout; rotating keeps the drawing. -->
        <activity
            android:name=".pen.PenTestActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />
        <!-- Debug builds only (it closes itself otherwise): the live 3D pen and its clips, for screenshots:
             adb shell am start -n com.charan.padstudio/.pen.PenModelDemoActivity
             Exported only to holders of DUMP, which the adb shell has and apps can't get, because adb can't
             start an unexported activity on a user build. -->
        <activity
            android:name=".pen.PenModelDemoActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Debug-friendly helpers: in-window pen event logger, and the rollback wallpaper reset. -->
        <activity
            android:name=".setup.PenProbeActivity"
            android:exported="false" />
        <activity
            android:name=".setup.ResetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.PadStudio.Panel" />

        <receiver
            android:name=".home.GroupWidgetReceiver"
            android:exported="true"
            android:label="@string/group_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/group_widget_info" />
        </receiver>

        <!-- The same widget in two more picker sizes (WidgetSize). -->
        <receiver
            android:name=".home.GroupWidgetSmallReceiver"
            android:exported="true"
            android:label="@string/group_widget_name_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/group_widget_small" />
        </receiver>
        <receiver
            android:name=".home.GroupWidgetLargeReceiver"
            android:exported="true"
            android:label="@string/group_widget_name_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/group_widget_large" />
        </receiver>

        <!-- Told by the launcher which widget id a pin request created, so it shows the requested group. -->
        <receiver
            android:name=".home.PinnedWidgetReceiver"
            android:exported="false" />

        <!-- Hands the generated pen profile to Key Mapper's restore screen. -->
        <provider
            android:name=".pen.ProfileFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
